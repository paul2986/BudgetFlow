{
  "name": "budget-flow",
  "version": "1.12.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && npx workbox generateSW workbox-config.js",
    "build:android": "expo prebuild -p android",
    "lint": "eslint .",
    "check:native": "expo install --check && expo export -p ios --output-dir .expo/check-native",
    "postinstall": "patch-package",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "db:start": "supabase start -x studio,storage-api,imgproxy,edge-runtime,logflare,vector,mailpit,postgres-meta,supavisor,realtime"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.3",
